---
const navItems = [
  { label: "Inicio", href: "#inicio" },
  { label: "Sobre mí", href: "#sobre-mi" },
  { label: "Servicios", href: "#servicios" },
  { label: "Peluditos", href: "#peluditos" },
  { label: "Tarifas", href: "#tarifas" },
  { label: "Contacto", href: "#contacto" },
];
---

<header class="site-header">
  <div class="container header-container">
    <a
      class="brand"
      href="#inicio"
      aria-label="Cuidando a Peluditos - Ir al inicio"
    >
      <span class="brand-icon" aria-hidden="true">🐾</span>

      <span class="brand-text">
        Cuidando a
        <strong>Peluditos</strong>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Navegación principal">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="contact-button desktop-contact" href="#contacto">
      Contactar
    </a>

    <button
      class="menu-button"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-navigation"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <nav
    id="mobile-navigation"
    class="mobile-nav"
    aria-label="Navegación móvil"
    data-open="false"
  >
    <div class="container">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>

      <a class="contact-button mobile-contact" href="#contacto">
        Contactar
      </a>
    </div>
  </nav>
</header>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>(".menu-button");
  const mobileNav = document.querySelector<HTMLElement>(".mobile-nav");

  if (menuButton && mobileNav) {
    const closeMenu = () => {
      menuButton.setAttribute("aria-expanded", "false");
      menuButton.setAttribute("aria-label", "Abrir menú");
      mobileNav.dataset.open = "false";
    };

    menuButton.addEventListener("click", () => {
      const isOpen = menuButton.getAttribute("aria-expanded") === "true";

      menuButton.setAttribute("aria-expanded", String(!isOpen));
      menuButton.setAttribute(
        "aria-label",
        isOpen ? "Abrir menú" : "Cerrar menú"
      );

      mobileNav.dataset.open = String(!isOpen);
    });

    mobileNav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;

    width: 100%;

    background: rgb(255 249 248 / 0.94);
    border-bottom: 1px solid var(--color-border);

    backdrop-filter: blur(12px);
  }

  .header-container {
    min-height: 4.5rem;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 1rem;
  }

  /* =========================
     Brand
     ========================= */

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;

    flex-shrink: 0;
  }

  .brand-icon {
    display: grid;
    place-items: center;

    width: 2.4rem;
    height: 2.4rem;

    font-size: 1.2rem;

    background: var(--color-surface-soft);
    border-radius: var(--radius-pill);
  }

  .brand-text {
    margin-top: 0.12rem;

    font-family: var(--font-family-heading);
    font-size: 1.05rem;
    font-weight: var(--font-weight-bold);

    color: var(--color-primary);
  }

  .brand-text strong {
    margin-top: 0.12rem;

    font-size: 1.05rem;
    font-weight: 700;

    color: var(--color-primary);
  }

  /* =========================
     Mobile button
     ========================= */

  .menu-button {
    width: 2.75rem;
    height: 2.75rem;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    gap: 0.3rem;

    padding: 0;

    color: var(--color-text);
    background: transparent;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);

    cursor: pointer;
  }

  .menu-button span {
    width: 1.25rem;
    height: 2px;

    background: currentColor;
    border-radius: var(--radius-pill);

    transition:
      transform var(--transition-fast),
      opacity var(--transition-fast);
  }

  .menu-button[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(0.4rem) rotate(45deg);
  }

  .menu-button[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  .menu-button[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-0.4rem) rotate(-45deg);
  }

  /* =========================
     Mobile navigation
     ========================= */

  .mobile-nav {
    display: grid;
    grid-template-rows: 0fr;

    overflow: hidden;

    border-top: 1px solid transparent;

    transition:
      grid-template-rows var(--transition-normal),
      border-color var(--transition-normal);
  }

  .mobile-nav > .container {
    overflow: hidden;
  }

  .mobile-nav[data-open="true"] {
    grid-template-rows: 1fr;

    border-color: var(--color-border);
  }

  .mobile-nav ul {
    list-style: none;

    display: flex;
    flex-direction: column;

    gap: 0;

    margin: 0;
    padding: 0.75rem 0 0;
  }

  .mobile-nav li {
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-nav li:last-child {
    border-bottom: 0;
  }

  .mobile-nav li a {
    display: block;

    padding: 0.85rem 0;

    font-weight: 500;
  }

  .contact-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 2.75rem;

    padding: 0.7rem 1.15rem;

    font-weight: 700;

    color: white;
    background: var(--color-primary);

    border-radius: var(--radius-pill);

    transition:
      background-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .mobile-contact {
    width: 100%;

    margin: 0.75rem 0 1.25rem;
  }

  .desktop-nav,
  .desktop-contact {
    display: none;
  }

  /* =========================
     Desktop
     ========================= */

  @media (min-width: 900px) {
    .header-container {
      min-height: 5rem;
    }

    .menu-button,
    .mobile-nav {
      display: none;
    }

    .desktop-nav {
      display: block;

      margin-left: auto;
    }

    .desktop-nav ul {
      list-style: none;

      display: flex;
      align-items: center;

      gap: 1.65rem;

      margin: 0;
      padding: 0;
    }

    .desktop-nav a {
      position: relative;

      padding-block: 0.4rem;

      font-size: 0.95rem;
      font-weight: 500;

      color: var(--color-text-muted);

      transition: color var(--transition-fast);
    }

    .desktop-nav a::after {
      content: "";

      position: absolute;
      right: 0;
      bottom: 0;
      left: 0;

      height: 2px;

      background: var(--color-primary);

      transform: scaleX(0);
      transform-origin: center;

      transition: transform var(--transition-fast);
    }

    .desktop-nav a:hover {
      color: var(--color-primary);
    }

    .desktop-nav a:hover::after {
      transform: scaleX(1);
    }

    .desktop-contact {
      display: inline-flex;

      margin-left: 0.5rem;
    }

    .contact-button:hover {
      background: var(--color-primary-hover);
      transform: translateY(-1px);
    }
  }
</style>