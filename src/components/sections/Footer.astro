---
import { Image } from "astro:assets";

import {
  Heart,
  MapPin,
  PawPrint,
} from "@lucide/astro";

import {
  siInstagram,
  siWhatsapp,
} from "simple-icons";

import logoAzul from "../../assets/images/logo_azul.png";

const currentYear = new Date().getFullYear();

const instagramUrl =
  "https://www.instagram.com/cuidando_a_peluditos/";

const whatsappUrl =
  "https://wa.me/56998817498";

const showWhatsApp = true;

const navItems = [
  { label: "Inicio", href: "#inicio" },
  { label: "Sobre mí", href: "#sobre-mi" },
  { label: "Servicios", href: "#servicios" },
  { label: "Tarifas", href: "#tarifas" },
  { label: "Contacto", href: "#contacto" },
];

const services = [
  "Paseos",
  "Cuidados",
  "Especiales",
];
---

<footer
  class="site-footer"
  aria-labelledby="footer-title"
>
  <div class="container footer-container">

    <!-- =====================================================
         TÍTULO SEMÁNTICO
         ===================================================== -->

    <h2
      id="footer-title"
      class="footer-sr-title"
    >
      Información de Cuidando a Peluditos
    </h2>

    <!-- =====================================================
         CONTENIDO PRINCIPAL
         ===================================================== -->

    <div class="footer-main">

      <!-- ===================================================
           MARCA
           =================================================== -->

      <div class="footer-brand">

        <a
          class="footer-logo-link"
          href="#inicio"
          aria-label="Cuidando a Peluditos - Ir al inicio"
        >
          <Image
            src={logoAzul}
            alt="Cuidando a Peluditos"
            class="footer-logo"
            loading="lazy"
            decoding="async"
            quality={75}
            widths={[160, 240, 320]}
            sizes="(max-width: 899px) 9rem, 10.5rem"
            />
        </a>

        <p class="footer-description">
          Cariño, compañía y cuidado para que
          cada peludito se sienta seguro y feliz.
        </p>

        <!-- Redes -->

        <div class="footer-socials">

          <a
            class="footer-social"
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram de Cuidando a Peluditos"
          >
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d={siInstagram.path}></path>
            </svg>
          </a>

          {
            showWhatsApp && (
              <a
                class="footer-social"
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Contactar a Cuidando a Peluditos por WhatsApp"
              >
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d={siWhatsapp.path}></path>
                </svg>
              </a>
            )
          }

        </div>

      </div>

      <!-- ===================================================
           COLUMNAS DESKTOP
           =================================================== -->

      <div class="footer-links">

        <!-- Navegación -->

        <div class="footer-column">

          <h3>
            Navegación
          </h3>

          <ul>
            {
              navItems.map((item) => (
                <li>
                  <a href={item.href}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>

        </div>

        <!-- Servicios -->

        <div class="footer-column">

          <h3>
            Servicios
          </h3>

          <ul>
            {
              services.map((service) => (
                <li>
                  <span>
                    {service}
                  </span>
                </li>
              ))
            }
          </ul>

        </div>

        <!-- Contacto -->

        <div class="footer-column footer-contact-column">

          <h3>
            Contacto
          </h3>

          <ul>

            <!-- Instagram -->

            <li class="footer-contact-item">

              <span
                class="footer-contact-icon"
                aria-hidden="true"
              >
                <svg viewBox="0 0 24 24">
                  <path d={siInstagram.path}></path>
                </svg>
              </span>

              <div>
                <strong>
                  Instagram
                </strong>

                <a
                  href={instagramUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  @cuidando_a_peluditos
                </a>
              </div>

            </li>

            <!-- WhatsApp -->

            {
              showWhatsApp && (
                <li class="footer-contact-item">

                  <span
                    class="footer-contact-icon"
                    aria-hidden="true"
                  >
                    <svg viewBox="0 0 24 24">
                      <path d={siWhatsapp.path}></path>
                    </svg>
                  </span>

                  <div>
                    <strong>
                      WhatsApp
                    </strong>

                    <a
                      href={whatsappUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Consultar disponibilidad
                    </a>
                  </div>

                </li>
              )
            }

            <!-- Cobertura -->

            <li class="footer-contact-item">

              <span
                class="footer-contact-icon"
                aria-hidden="true"
              >
                <MapPin
                  size={18}
                  stroke-width={1.9}
                />
              </span>

              <div>
                <strong>
                  Cobertura
                </strong>

                <span>
                  Sector Oriente de Santiago
                </span>
              </div>

            </li>

          </ul>

        </div>

      </div>

    </div>

    <!-- =====================================================
         DIVISOR
         ===================================================== -->

    <div
      class="footer-divider"
      aria-hidden="true"
    >
      <span></span>

      <PawPrint
        size={18}
        stroke-width={1.8}
      />

      <span></span>
    </div>

    <!-- =====================================================
         MOBILE NAV
         ===================================================== -->

    <nav
      class="footer-mobile-nav"
      aria-label="Navegación del pie de página"
    >
      {
        navItems.map((item) => (
          <a href={item.href}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- =====================================================
         PARTE INFERIOR
         ===================================================== -->

    <div class="footer-bottom">

      <p class="footer-love">
        <Heart
          size={16}
          stroke-width={1.9}
          aria-hidden="true"
        />

        <span>
          Hecho con cariño por y para los peluditos.
        </span>
      </p>

      <p class="footer-copyright">
        © {currentYear} Cuidando a Peluditos.
        Todos los derechos reservados.
      </p>

    </div>

  </div>

  <!-- =====================================================
       DECORACIÓN
       ===================================================== -->

  <span
    class="footer-blob footer-blob-left"
    aria-hidden="true"
  ></span>

  <span
    class="footer-blob footer-blob-right"
    aria-hidden="true"
  ></span>

</footer>

<style>
  /* =========================================================
     TÍTULO SOLO PARA LECTORES DE PANTALLA
     ========================================================= */

  .footer-sr-title {
    position: absolute;

    width: 1px;
    height: 1px;

    padding: 0;
    margin: -1px;

    overflow: hidden;

    clip: rect(0, 0, 0, 0);

    white-space: nowrap;

    border: 0;
  }

  /* =========================================================
     FOOTER
     ========================================================= */

  .site-footer {
    position: relative;

    overflow: hidden;

    padding:
      3.5rem
      0
      1.75rem;

    background:
      linear-gradient(
        180deg,
        #fffaf9 0%,
        #fff5f5 100%
      );

    border-top:
      1px solid
      rgb(247 183 195 / 0.3);
  }

  .footer-container {
    position: relative;

    z-index: 1;
  }

  /* =========================================================
     CONTENIDO PRINCIPAL
     ========================================================= */

  .footer-main {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr);

    gap: 2.25rem;
  }

  /* =========================================================
     BRAND
     ========================================================= */

  .footer-brand {
    display: flex;
    flex-direction: column;

    align-items: center;

    text-align: center;
  }

  .footer-logo-link {
    display: block;
  }

  .footer-logo-link :global(.footer-logo) {
    display: block;

    width: auto;
    height: 6rem;

    object-fit: contain;
  }

  .footer-description {
    max-width: 21rem;

    margin-top: 0.6rem;

    font-size: 0.9rem;
    line-height: 1.6;

    color:
      var(--color-text-muted);
  }

  /* =========================================================
     REDES
     ========================================================= */

  .footer-socials {
    display: flex;
    align-items: center;

    gap: 0.65rem;

    margin-top: 1.1rem;
  }

  .footer-social {
    width: 2.65rem;
    height: 2.65rem;

    display: grid;
    place-items: center;

    color:
      var(--color-secondary);

    background:
      rgb(255 255 255 / 0.75);

    border:
      1px solid
      var(--color-border);

    border-radius:
      var(--radius-pill);

    transition:
      color
        var(--transition-fast),
      background-color
        var(--transition-fast),
      border-color
        var(--transition-fast),
      transform
        var(--transition-fast);
  }

  .footer-social svg {
    width: 1.15rem;
    height: 1.15rem;

    fill:
      currentColor;
  }

  /* =========================================================
     COLUMNAS
     ========================================================= */

  .footer-links {
    display: none;
  }

  /* =========================================================
     DIVISOR
     ========================================================= */

  .footer-divider {
    display: flex;
    align-items: center;

    gap: 0.8rem;

    max-width: 32rem;

    margin:
      2.2rem
      auto
      1.4rem;
  }

  .footer-divider span {
    height: 1px;

    flex: 1;

    background:
      rgb(244 143 163 / 0.3);
  }

  .footer-divider > svg {
    flex-shrink: 0;

    color:
      var(--color-primary);
  }

  /* =========================================================
     MOBILE NAV
     ========================================================= */

  .footer-mobile-nav {
    display: flex;
    flex-wrap: wrap;

    align-items: center;
    justify-content: center;

    gap:
      0.55rem
      1rem;

    max-width: 24rem;

    margin-inline: auto;
  }

  .footer-mobile-nav a {
    position: relative;

    font-size: 0.86rem;
    font-weight:
      var(--font-weight-medium);

    color:
      var(--color-text-muted);

    transition:
      color
      var(--transition-fast);
  }

  .footer-mobile-nav a:not(:last-child)::after {
    content: "";

    position: absolute;

    top: 50%;
    right: -0.55rem;

    width: 0.2rem;
    height: 0.2rem;

    background:
      var(--color-primary);

    border-radius:
      var(--radius-pill);

    transform:
      translateY(-50%);
  }

  /* =========================================================
     BOTTOM
     ========================================================= */

  .footer-bottom {
    display: flex;
    flex-direction: column;

    align-items: center;

    gap: 0.65rem;

    margin-top: 1.5rem;

    text-align: center;
  }

  .footer-love {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 0.45rem;

    margin: 0;

    font-size: 0.82rem;
    line-height: 1.45;

    color:
      var(--color-text-muted);
  }

  .footer-love > svg {
    flex-shrink: 0;

    color:
      var(--color-primary);
  }

  .footer-copyright {
    max-width: 24rem;

    margin: 0;

    font-size: 0.76rem;
    line-height: 1.5;

    color:
      var(--color-text-muted);
  }

  /* =========================================================
     DECORACIONES
     ========================================================= */

  .footer-blob {
    position: absolute;

    z-index: 0;

    pointer-events: none;
  }

  .footer-blob-left {
    width: 12rem;
    height: 6rem;

    left: -5rem;
    top: -3rem;

    background:
      rgb(247 183 195 / 0.13);

    border-radius:
      45% 55% 60% 40% /
      50% 45% 55% 50%;

    transform:
      rotate(-7deg);
  }

  .footer-blob-right {
    width: 13rem;
    height: 7rem;

    right: -5rem;
    bottom: -3rem;

    background:
      rgb(247 183 195 / 0.13);

    border-radius:
      55% 45% 42% 58% /
      44% 55% 45% 56%;

    transform:
      rotate(8deg);
  }

  /* =========================================================
     DESKTOP
     ========================================================= */

  @media (min-width: 900px) {

    .site-footer {
      padding:
        4.5rem
        0
        2rem;
    }

    .footer-main {
      grid-template-columns:
        minmax(15rem, 0.8fr)
        minmax(0, 1.7fr);

      align-items: start;

      gap: 4rem;
    }

    .footer-brand {
      align-items: flex-start;

      text-align: left;
    }

    .footer-logo-link :global(.footer-logo) {
      height: 7rem;
    }

    .footer-description {
      max-width: 18rem;

      margin-top: 0.4rem;

      font-size: 0.9rem;
    }

    /* =======================================================
       COLUMNAS
       ======================================================= */

    .footer-links {
      display: grid;

      grid-template-columns:
        0.85fr
        0.75fr
        1.4fr;

      gap: 2.5rem;
    }

    .footer-column h3 {
      width: fit-content;

      margin:
        0
        0
        1.1rem;

      padding-bottom: 0.55rem;

      font-size: 1rem;
      line-height: 1.2;

      color:
        var(--color-secondary);

      border-bottom:
        1px solid
        rgb(244 143 163 / 0.45);
    }

    .footer-column ul {
      list-style: none;

      display: flex;
      flex-direction: column;

      gap: 0.65rem;

      margin: 0;

      padding: 0;
    }

    .footer-column li,
    .footer-column a,
    .footer-column span {
      font-size: 0.86rem;
      line-height: 1.5;

      color:
        var(--color-text-muted);
    }

    .footer-column a {
      transition:
        color
        var(--transition-fast);
    }

    /* =======================================================
       CONTACT
       ======================================================= */

    .footer-contact-column ul {
      gap: 0.85rem;
    }

    .footer-contact-item {
      display: grid;

      grid-template-columns:
        auto
        minmax(0, 1fr);

      align-items: start;

      gap: 0.65rem;
    }

    .footer-contact-icon {
      width: 2rem;
      height: 2rem;

      display: grid;
      place-items: center;

      flex-shrink: 0;

      color:
        var(--color-primary);

      background:
        var(--color-surface-soft);

      border-radius:
        var(--radius-pill);
    }

    .footer-contact-icon svg {
      width: 0.95rem;
      height: 0.95rem;

      fill:
        currentColor;
    }

    .footer-contact-icon :global(svg) {
      width: 1rem;
      height: 1rem;
    }

    .footer-contact-item strong {
      display: block;

      margin-bottom: 0.05rem;

      font-size: 0.84rem;

      color:
        var(--color-secondary);
    }

    /* =======================================================
       MOBILE NAV
       ======================================================= */

    .footer-mobile-nav {
      display: none;
    }

    /* =======================================================
       DIVISOR
       ======================================================= */

    .footer-divider {
      max-width: none;

      margin:
        3rem
        0
        1.35rem;
    }

    /* =======================================================
       BOTTOM
       ======================================================= */

    .footer-bottom {
      flex-direction: row;

      align-items: center;
      justify-content: space-between;

      gap: 2rem;

      margin-top: 0;

      text-align: left;
    }

    .footer-love {
      font-size: 0.82rem;
    }

    .footer-copyright {
      max-width: none;

      font-size: 0.78rem;

      text-align: right;
    }
  }

  /* =========================================================
     HOVER
     ========================================================= */

  @media (hover: hover) and (pointer: fine) {

    .footer-social:hover {
      color:
        var(--color-primary);

      background:
        var(--color-surface-soft);

      border-color:
        rgb(244 143 163 / 0.4);

      transform:
        translateY(-2px);
    }

    .footer-column a:hover,
    .footer-mobile-nav a:hover {
      color:
        var(--color-primary);
    }
  }
</style>