---
import { Image } from "astro:assets";

import logoAzul from "../../assets/images/logo_azul.png";

const navItems = [
  { label: "Inicio", href: "#inicio" },
  { label: "Sobre mí", href: "#sobre-mi" },
  { label: "Servicios", href: "#servicios" },
  { label: "Tarifas", href: "#tarifas" },
  { label: "Contacto", href: "#contacto" },
];
---

<header class="site-header">
  <div class="container header-container">

    <!-- =====================================================
         LOGO
         ===================================================== -->

    <a
      class="brand"
      href="#inicio"
      aria-label="Cuidando a Peluditos - Ir al inicio"
    >
      <Image
        src={logoAzul}
        alt="Cuidando a Peluditos"
        class="brand-logo"
        loading="eager"
        decoding="async"
        quality={75}
        widths={[160, 240, 320]}
        sizes="(max-width: 1099px) 10.5rem, 13rem"
      />
    </a>

    <!-- =====================================================
         NAVEGACIÓN DESKTOP
         ===================================================== -->

    <nav
      class="desktop-nav"
      aria-label="Navegación principal"
    >
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- =====================================================
         CONTACTO DESKTOP
         ===================================================== -->

    <a
      class="contact-button desktop-contact"
      href="#contacto"
    >
      Contactar
    </a>

    <!-- =====================================================
         BOTÓN MOBILE
         ===================================================== -->

    <button
      class="menu-button"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-navigation"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

  </div>

  <!-- =======================================================
       NAVEGACIÓN MOBILE
       ======================================================= -->

  <nav
    id="mobile-navigation"
    class="mobile-nav"
    aria-label="Navegación móvil"
    data-open="false"
  >
    <div class="container">

      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a
        class="contact-button mobile-contact"
        href="#contacto"
      >
        Contactar
      </a>

    </div>
  </nav>
</header>

<script>
  const header =
    document.querySelector<HTMLElement>(
      ".site-header"
    );

  const menuButton =
    document.querySelector<HTMLButtonElement>(
      ".menu-button"
    );

  const mobileNav =
    document.querySelector<HTMLElement>(
      ".mobile-nav"
    );

  if (header && menuButton && mobileNav) {

    /* =========================================
       CERRAR MENÚ
       ========================================= */

    const closeMenu = () => {
      menuButton.setAttribute(
        "aria-expanded",
        "false"
      );

      menuButton.setAttribute(
        "aria-label",
        "Abrir menú"
      );

      mobileNav.dataset.open = "false";
    };

    /* =========================================
       ABRIR / CERRAR MENÚ
       ========================================= */

    menuButton.addEventListener(
      "click",
      () => {
        const isOpen =
          menuButton.getAttribute(
            "aria-expanded"
          ) === "true";

        menuButton.setAttribute(
          "aria-expanded",
          String(!isOpen)
        );

        menuButton.setAttribute(
          "aria-label",
          isOpen
            ? "Abrir menú"
            : "Cerrar menú"
        );

        mobileNav.dataset.open =
          String(!isOpen);
      }
    );

    /* =========================================
       ESPERAR CIERRE REAL DEL MENÚ
       ========================================= */

    const waitForMenuClose = () => {
      return new Promise<void>(
        (resolve) => {
          let finished = false;

          const finish = () => {
            if (finished) return;

            finished = true;

            mobileNav.removeEventListener(
              "transitionend",
              handleTransitionEnd
            );

            resolve();
          };

          const handleTransitionEnd = (
            event: TransitionEvent
          ) => {
            if (
              event.propertyName ===
              "grid-template-rows"
            ) {
              finish();
            }
          };

          mobileNav.addEventListener(
            "transitionend",
            handleTransitionEnd
          );

          window.setTimeout(
            finish,
            340
          );
        }
      );
    };

    /* =========================================
       BUSCAR PUNTO VISUAL CORRECTO
       ========================================= */

    const getVisualTarget = (
      target: HTMLElement
    ) => {
      if (
        target.matches(
          "h1, h2, [data-scroll-anchor]"
        )
      ) {
        return target;
      }

      const heading =
        target.querySelector<HTMLElement>(
          "h1, h2, [data-scroll-anchor]"
        );

      return heading ?? target;
    };

    /* =========================================
       FIJAR REVEAL DEL DESTINO
       ========================================= */

    const settleRevealTarget = (
      visualTarget: HTMLElement
    ) => {
      let current:
        HTMLElement | null =
          visualTarget;

      while (
        current &&
        current !== document.body
      ) {
        if (
          current.hasAttribute(
            "data-reveal"
          )
        ) {
          current.style.setProperty(
            "transition",
            "none"
          );

          current.style.setProperty(
            "opacity",
            "1"
          );

          current.style.setProperty(
            "transform",
            "none"
          );

          current.classList.add(
            "is-visible"
          );

          void current.offsetHeight;

          current.style.removeProperty(
            "transition"
          );

          current.style.removeProperty(
            "opacity"
          );

          current.style.removeProperty(
            "transform"
          );
        }

        current =
          current.parentElement;
      }
    };

    /* =========================================
       SCROLL MOBILE
       ========================================= */

    const scrollToMobileSection = (
      hash: string
    ) => {
      if (hash === "#inicio") {
        window.scrollTo({
          top: 0,
          behavior: "smooth",
        });

        return;
      }

      const target =
        document.querySelector<HTMLElement>(
          hash
        );

      if (!target) return;

      const visualTarget =
        getVisualTarget(target);

      settleRevealTarget(
        visualTarget
      );

      requestAnimationFrame(() => {
        const headerHeight =
          header
            .getBoundingClientRect()
            .height;

        const extraGap = 12;

        const targetPosition =
          visualTarget
            .getBoundingClientRect()
            .top +
          window.scrollY -
          headerHeight -
          extraGap;

        window.scrollTo({
          top: Math.max(
            0,
            targetPosition
          ),

          behavior: "smooth",
        });
      });
    };

    /* =========================================
       LINKS MOBILE
       ========================================= */

    mobileNav
      .querySelectorAll<HTMLAnchorElement>(
        'a[href^="#"]'
      )
      .forEach((link) => {
        link.addEventListener(
          "click",
          async (event) => {

            /*
             * Desde 1100px se considera
             * navegación desktop.
             */

            if (
              window.matchMedia(
                "(min-width: 1100px)"
              ).matches
            ) {
              return;
            }

            const hash =
              link.getAttribute("href");

            if (
              !hash ||
              hash === "#"
            ) {
              return;
            }

            event.preventDefault();

            closeMenu();

            await waitForMenuClose();

            scrollToMobileSection(
              hash
            );

            if (
              window.location.hash !== hash
            ) {
              history.pushState(
                null,
                "",
                hash
              );
            }
          }
        );
      });

    /* =========================================
       ESCAPE
       ========================================= */

    document.addEventListener(
      "keydown",
      (event) => {
        if (
          event.key === "Escape"
        ) {
          closeMenu();
        }
      }
    );

    /* =========================================
       RESET AL PASAR A DESKTOP
       ========================================= */

    window
      .matchMedia(
        "(min-width: 1100px)"
      )
      .addEventListener(
        "change",
        (event) => {
          if (event.matches) {
            closeMenu();
          }
        }
      );
  }
</script>

<style>
  /* =========================================================
     HEADER
     ========================================================= */

  .site-header {
    position: sticky;
    top: 0;

    z-index: 100;

    width: 100%;

    background:
      rgb(255 249 248 / 0.94);

    border-bottom:
      1px solid
      var(--color-border);

    backdrop-filter:
      blur(12px);
  }

  .header-container {
    height: 4.5rem;
    min-height: 4.5rem;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 1rem;
  }

  /* =========================================================
     BRAND / LOGO
     ========================================================= */

  .brand {
    position: relative;

    display: block;

    width: 10.5rem;
    height: 4.5rem;

    flex:
      0
      0
      10.5rem;

    overflow: visible;
  }

  .brand :global(.brand-logo) {
    position: absolute;

    top: 50%;
    left: -0.45rem;

    display: block;

    width: auto;
    height: 5rem;

    max-width: none;

    object-fit: contain;

    transform:
      translateY(-50%);

    transform-origin:
      left center;
  }

  /* =========================================================
     BOTÓN MOBILE
     ========================================================= */

  .menu-button {
    width: 2.75rem;
    height: 2.75rem;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    gap: 0.3rem;

    padding: 0;

    color:
      var(--color-text);

    background:
      transparent;

    border:
      1px solid
      var(--color-border);

    border-radius:
      var(--radius-md);

    cursor: pointer;
  }

  .menu-button span {
    width: 1.25rem;
    height: 2px;

    background:
      currentColor;

    border-radius:
      var(--radius-pill);

    transition:
      transform
        var(--transition-fast),
      opacity
        var(--transition-fast);
  }

  .menu-button[
    aria-expanded="true"
  ]
  span:nth-child(1) {
    transform:
      translateY(0.4rem)
      rotate(45deg);
  }

  .menu-button[
    aria-expanded="true"
  ]
  span:nth-child(2) {
    opacity: 0;
  }

  .menu-button[
    aria-expanded="true"
  ]
  span:nth-child(3) {
    transform:
      translateY(-0.4rem)
      rotate(-45deg);
  }

  /* =========================================================
     MOBILE NAV
     ========================================================= */

  .mobile-nav {
    display: grid;

    grid-template-rows:
      0fr;

    overflow: hidden;

    border-top:
      1px solid
      transparent;

    transition:
      grid-template-rows
        var(--transition-normal),
      border-color
        var(--transition-normal);
  }

  .mobile-nav > .container {
    overflow: hidden;
  }

  .mobile-nav[data-open="true"] {
    grid-template-rows:
      1fr;

    border-color:
      var(--color-border);
  }

  .mobile-nav ul {
    list-style: none;

    display: flex;
    flex-direction: column;

    gap: 0;

    margin: 0;

    padding:
      0.75rem
      0
      0;
  }

  .mobile-nav li {
    border-bottom:
      1px solid
      var(--color-border);
  }

  .mobile-nav li:last-child {
    border-bottom: 0;
  }

  .mobile-nav li a {
    display: block;

    padding:
      0.85rem
      0;

    font-weight: 500;
  }

  /* =========================================================
     CONTACT BUTTON
     ========================================================= */

  .contact-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 2.75rem;

    padding:
      0.7rem
      1.15rem;

    font-weight: 700;

    color:
      var(--color-secondary);

    background:
      var(--color-primary);

    border-radius:
      var(--radius-pill);

    transition:
      background-color
        var(--transition-fast),
      transform
        var(--transition-fast);
  }

  .mobile-contact {
    width: 100%;

    margin:
      0.75rem
      0
      1.25rem;
  }

  .desktop-nav,
  .desktop-contact {
    display: none;
  }

  /* =========================================================
     DESKTOP
     ========================================================= */

  @media (min-width: 1100px) {

    .header-container {
      height: 5rem;
      min-height: 5rem;
    }

    /* =======================================================
       LOGO DESKTOP
       ======================================================= */

    .brand {
      width: 13rem;
      height: 5rem;

      flex-basis: 13rem;
    }

    .brand :global(.brand-logo) {
      height: 7rem;

      left: -0.7rem;
    }

    /* =======================================================
       OCULTAR MOBILE
       ======================================================= */

    .menu-button,
    .mobile-nav {
      display: none;
    }

    /* =======================================================
       NAV DESKTOP
       ======================================================= */

    .desktop-nav {
      display: block;

      margin-left: auto;
    }

    .desktop-nav ul {
      list-style: none;

      display: flex;
      align-items: center;

      gap: 1.65rem;

      margin: 0;

      padding: 0;
    }

    .desktop-nav a {
      position: relative;

      padding-block: 0.4rem;

      font-size: 0.95rem;

      font-weight: 500;

      color:
        var(--color-text-muted);

      transition:
        color
        var(--transition-fast);
    }

    .desktop-nav a::after {
      content: "";

      position: absolute;

      right: 0;
      bottom: 0;
      left: 0;

      height: 2px;

      background:
        var(--color-primary);

      transform:
        scaleX(0);

      transform-origin:
        center;

      transition:
        transform
        var(--transition-fast);
    }

    .desktop-nav a:hover {
      color:
        var(--color-primary);
    }

    .desktop-nav a:hover::after {
      transform:
        scaleX(1);
    }

    /* =======================================================
       CONTACTAR DESKTOP
       ======================================================= */

    .desktop-contact {
      display:
        inline-flex;

      margin-left:
        0.5rem;
    }

    .contact-button:hover {
      background:
        var(--color-primary-hover);

      transform:
        translateY(-1px);
    }
  }
</style>