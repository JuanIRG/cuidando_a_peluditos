---
import "../styles/global.css";

/* =========================================================
   FUENTES VARIABLES LOCALES
   ========================================================= */

import "@fontsource-variable/fredoka/wght.css";
import "@fontsource-variable/nunito/wght.css";

import { SITE } from "../config/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
} = Astro.props;

/* =========================================================
   BASE URL
   ========================================================= */

const baseUrl =
  import.meta.env.BASE_URL.endsWith("/")
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;

/* =========================================================
   URL DE PRODUCCIÓN
   ========================================================= */

const siteUrl = Astro.site;

const homeUrl = siteUrl
  ? new URL(
      baseUrl,
      siteUrl
    ).toString()
  : undefined;

const pageUrl = siteUrl
  ? new URL(
      Astro.url.pathname,
      siteUrl
    ).toString()
  : undefined;

/* =========================================================
   IMAGEN SOCIAL
   ========================================================= */

const socialImageUrl = siteUrl
  ? new URL(
      `${baseUrl}og-image.png`,
      siteUrl
    ).toString()
  : undefined;

/* =========================================================
   LOGO PARA DATOS ESTRUCTURADOS
   ========================================================= */

const logoUrl = socialImageUrl;

/* =========================================================
   DATOS ESTRUCTURADOS
   ========================================================= */

const structuredData =
  siteUrl && homeUrl
    ? {
        "@context": "https://schema.org",

        "@graph": [
          {
            "@type": "Organization",

            "@id":
              `${homeUrl}#organization`,

            name:
              SITE.name,

            url:
              homeUrl,

            description:
              "Servicio de paseos y cuidados de mascotas en el Sector Oriente de Santiago.",

            ...(logoUrl && {
              logo: {
                "@type": "ImageObject",
                url: logoUrl,
              },
            }),

            sameAs: [
              "https://www.instagram.com/cuidando_a_peluditos/",
            ],

            hasOfferCatalog: {
              "@type": "OfferCatalog",

              name:
                "Servicios de Cuidando a Peluditos",

              itemListElement: [
                {
                  "@type": "Offer",

                  itemOffered: {
                    "@type": "Service",

                    name:
                      "Paseos de mascotas",

                    serviceType:
                      "Paseo de perros",

                    description:
                      "Paseos con cariño, ejercicio y atención para que cada peludito disfrute, se active y libere energía.",

                    areaServed:
                      "Sector Oriente de Santiago",
                  },
                },

                {
                  "@type": "Offer",

                  itemOffered: {
                    "@type": "Service",

                    name:
                      "Cuidados nocturnos de mascotas",

                    serviceType:
                      "Cuidado de mascotas",

                    description:
                      "Cuidado nocturno a domicilio con atención personalizada y paseos según la rutina del peludito.",

                    areaServed:
                      "Sector Oriente de Santiago",
                  },
                },

                {
                  "@type": "Offer",

                  itemOffered: {
                    "@type": "Service",

                    name:
                      "Cuidados especiales de mascotas",

                    serviceType:
                      "Cuidado personalizado de mascotas",

                    description:
                      "Cuidado personalizado para cachorros, peluditos mayores o mascotas con necesidades y rutinas especiales.",

                    areaServed:
                      "Sector Oriente de Santiago",
                  },
                },
              ],
            },
          },

          {
            "@type": "Service",

            "@id":
              `${homeUrl}#pet-care-service`,

            name:
              "Paseos y cuidados de mascotas",

            serviceType:
              "Paseo y cuidado de mascotas",

            description:
              "Paseos, cuidados nocturnos y atención personalizada para mascotas en el Sector Oriente de Santiago.",

            areaServed:
              "Sector Oriente de Santiago",

            provider: {
              "@id":
                `${homeUrl}#organization`,
            },

            url:
              pageUrl ?? homeUrl,
          },
        ],
      }
    : undefined;
---

<!doctype html>

<html lang={SITE.language}>
  <head>

    <!-- =====================================================
         BÁSICOS
         ===================================================== -->

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="generator"
      content={Astro.generator}
    />

    <!-- =====================================================
         FAVICON
         ===================================================== -->

    <link
      rel="icon"
      type="image/png"
      href={`${baseUrl}favicon.png`}
    />

    <!-- =====================================================
         SISTEMA GLOBAL DE REVEAL
         ===================================================== -->

    <script is:inline>
      if (
        !window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches
      ) {
        document.documentElement.classList.add(
          "reveal-ready"
        );
      }
    </script>

    <!-- =====================================================
         SEO BÁSICO
         ===================================================== -->

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

    <meta
      name="robots"
      content="index, follow"
    />

    <!-- =====================================================
         OPEN GRAPH
         ===================================================== -->

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:site_name"
      content={SITE.name}
    />

    <meta
      property="og:title"
      content={title}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:locale"
      content="es_CL"
    />

    {
      pageUrl && (
        <meta
          property="og:url"
          content={pageUrl}
        />
      )
    }

    {
      socialImageUrl && (
        <>
          <meta
            property="og:image"
            content={socialImageUrl}
          />

          <meta
            property="og:image:alt"
            content="Cuidando a Peluditos"
          />
        </>
      )
    }

    <!-- =====================================================
         TWITTER / X
         ===================================================== -->

    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={title}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    {
      socialImageUrl && (
        <>
          <meta
            name="twitter:image"
            content={socialImageUrl}
          />

          <meta
            name="twitter:image:alt"
            content="Cuidando a Peluditos"
          />
        </>
      )
    }

    <!-- =====================================================
         COLOR DEL NAVEGADOR
         ===================================================== -->

    <meta
      name="theme-color"
      content="#fff9f8"
    />

    <!-- =====================================================
         DATOS ESTRUCTURADOS
         ===================================================== -->

    {
      structuredData && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(
            structuredData
          )}
        />
      )
    }

  </head>

  <body>

    <slot />

    <!-- =====================================================
         CONTROLADOR GLOBAL DE ANIMACIONES
         ===================================================== -->

    <script is:inline>
      function initRevealAnimations() {
        const elements =
          document.querySelectorAll(
            "[data-reveal]"
          );

        if (!elements.length) {
          return;
        }

        const reducedMotion =
          window.matchMedia(
            "(prefers-reduced-motion: reduce)"
          ).matches;

        if (reducedMotion) {
          elements.forEach(
            (element) => {
              element.classList.add(
                "is-visible"
              );
            }
          );

          return;
        }

        const observer =
          new IntersectionObserver(
            (
              entries,
              currentObserver
            ) => {
              entries.forEach(
                (entry) => {
                  if (
                    !entry.isIntersecting
                  ) {
                    return;
                  }

                  const element =
                    entry.target;

                  requestAnimationFrame(
                    () => {
                      element.classList.add(
                        "is-visible"
                      );
                    }
                  );

                  currentObserver.unobserve(
                    element
                  );
                }
              );
            },
            {
              threshold: 0.18,

              rootMargin:
                "0px 0px -8% 0px",
            }
          );

        elements.forEach(
          (element) => {
            const delay =
              element.getAttribute(
                "data-reveal-delay"
              );

            if (delay) {
              element.style.setProperty(
                "--reveal-delay",
                `${delay}ms`
              );
            }

            observer.observe(
              element
            );
          }
        );
      }

      if (
        document.readyState ===
        "loading"
      ) {
        document.addEventListener(
          "DOMContentLoaded",
          () => {
            requestAnimationFrame(
              () => {
                initRevealAnimations();
              }
            );
          },
          {
            once: true,
          }
        );
      } else {
        requestAnimationFrame(
          () => {
            initRevealAnimations();
          }
        );
      }
    </script>

  </body>
</html>