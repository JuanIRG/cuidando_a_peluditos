---
import { Image } from "astro:assets";

import {
  Dog,
  HeartHandshake,
  ShieldCheck,
} from "@lucide/astro";

import danielaAbout from "../../assets/images/daniela_about.png";
---

<section
  id="sobre-mi"
  class="about"
  aria-labelledby="about-title"
>
  <div class="container about-container">

    <!-- =========================
         Fotografía
         ========================= -->

    <div
      class="about-visual"
      data-reveal="left"
    >
      <div
        class="about-photo-shape"
        aria-hidden="true"
      ></div>

      <div class="about-photo">
        <Image
          src={danielaAbout}
          alt="Daniela junto a uno de los peluditos que cuida"
          class="about-image"
          loading="lazy"
          decoding="async"
          widths={[160, 240, 320, 384, 480, 640, 768]}
          sizes="(max-width: 699px) 7.5rem, (max-width: 899px) 10rem, 24rem"
        />
      </div>

      <span
        class="photo-heart"
        aria-hidden="true"
      >
        ♥
      </span>

      <span
        class="photo-paw"
        aria-hidden="true"
      >
        🐾
      </span>
    </div>

    <!-- =========================
         Presentación
         ========================= -->

    <div
      class="about-intro"
      data-reveal="right"
      data-reveal-delay="100"
    >
      <h2 id="about-title">
        Soy Daniela

        <span aria-hidden="true">
          ♥
        </span>
      </h2>

      <p class="about-description">
        Amante de los animales y paseadora con años de experiencia. El cuidado de cada peludito lo tomo con cariño,
        responsabilidad y mucha atención. Cada peludito es unico por lo cual merece una atención unica.
      </p>
    </div>

    <!-- =========================
         Cualidades
         ========================= -->

    <ul
      class="about-qualities"
      aria-label="Características del cuidado"
    >
      <li
        data-reveal="up"
        data-reveal-delay="200"
      >
        <span
          class="quality-icon"
          aria-hidden="true"
        >
          <Dog
            size={26}
            stroke-width={1.8}
          />
        </span>

        <h3>
          Paseos con amor
        </h3>
      </li>

      <li
        data-reveal="up"
        data-reveal-delay="320"
      >
        <span
          class="quality-icon"
          aria-hidden="true"
        >
          <HeartHandshake
            size={26}
            stroke-width={1.8}
          />
        </span>

        <h3>
          Atención personalizada
        </h3>
      </li>

      <li
        data-reveal="up"
        data-reveal-delay="440"
      >
        <span
          class="quality-icon"
          aria-hidden="true"
        >
          <ShieldCheck
            size={26}
            stroke-width={1.8}
          />
        </span>

        <h3>
          Confianza y cuidado
        </h3>
      </li>
    </ul>

    <!-- =========================
         Frase
         ========================= -->

    <blockquote
      class="about-quote"
      data-reveal="up"
      data-reveal-delay="560"
    >
      <span
        class="quote-mark"
        aria-hidden="true"
      >
        “
      </span>

      <p>
        Cada paseo es una experiencia
        pensada para su bienestar.
      </p>

      <span
        class="quote-mark quote-mark-close"
        aria-hidden="true"
      >
        ”
      </span>

    </blockquote>

  </div>
</section>

<style>
  /* =========================================================
     SECTION
     ========================================================= */

  .about {
    position: relative;
    overflow: hidden;

    padding-block: 4rem;

    background:
      linear-gradient(
        180deg,
        var(--color-background) 0%,
        #fffdfb 100%
      );
  }

  /* =========================================================
     MOBILE FIRST
     ========================================================= */

  .about-container {
    display: grid;

    grid-template-columns:
      7.75rem
      minmax(0, 1fr);

    grid-template-areas:
      "visual intro"
      "qualities qualities"
      "quote quote";

    align-items: center;

    column-gap: 1.15rem;
    row-gap: 2.25rem;
  }

  /* =========================================================
     FOTOGRAFÍA
     ========================================================= */

  .about-visual {
    grid-area: visual;

    position: relative;

    width: 7.5rem;

    justify-self: start;
    align-self: center;

    isolation: isolate;
  }

  .about-photo-shape {
    position: absolute;
    z-index: -1;

    inset:
      0.45rem
      -0.45rem
      -0.45rem
      0.5rem;

    background:
      var(--color-surface-soft);

    border-radius:
      44% 56% 50% 50% /
      48% 42% 58% 52%;

    transform:
      rotate(-4deg);
  }

  .about-photo {
    position: relative;

    width: 100%;
    aspect-ratio: 1 / 1.08;

    overflow: hidden;

    border-radius:
      42% 58% 48% 52% /
      44% 40% 60% 56%;

    box-shadow:
      0 10px 28px
      rgb(39 48 90 / 0.08);

    transition:
      transform
      var(--transition-normal),
      box-shadow
      var(--transition-normal);
  }

  .about-photo
  :global(.about-image) {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
    object-position: center;

    transform:
      scale(1.02);
  }

  /* =========================================================
     DECORACIONES FOTO
     ========================================================= */

  .photo-heart {
    position: absolute;
    z-index: 2;

    top: -0.35rem;
    right: -0.2rem;

    width: 1.8rem;
    height: 1.8rem;

    display: grid;
    place-items: center;

    font-size: 0.8rem;

    color:
      var(--color-primary);

    background:
      var(--color-background);

    border-radius:
      var(--radius-pill);

    box-shadow:
      var(--shadow-sm);

    transform:
      rotate(8deg);

    pointer-events: none;
  }

  .photo-paw {
    position: absolute;
    z-index: 2;

    right: -0.45rem;
    bottom: 0.45rem;

    width: 2rem;
    height: 2rem;

    display: grid;
    place-items: center;

    font-size: 0.72rem;

    background:
      var(--color-primary);

    border:
      3px solid
      var(--color-background);

    border-radius:
      var(--radius-pill);

    box-shadow:
      var(--shadow-sm);

    transform:
      rotate(10deg);

    pointer-events: none;
  }

  /* =========================================================
     INTRO
     ========================================================= */

  .about-intro {
    grid-area: intro;

    min-width: 0;
  }

  .about-intro h2 {
    display: flex;
    align-items: center;
    flex-wrap: wrap;

    gap: 0.35rem;

    font-size:
      clamp(
        1.9rem,
        7.8vw,
        2.45rem
      );

    line-height: 1.05;
    letter-spacing:
      -0.025em;
  }

  .about-intro h2 span {
    font-size: 0.75rem;

    color:
      var(--color-primary);
  }

  .about-description {
    max-width: 17rem;

    margin-top: 0.85rem;

    font-size: 0.9rem;
    line-height: 1.6;

    color:
      var(--color-text-muted);
  }

  /* =========================================================
     CUALIDADES
     ========================================================= */

  .about-qualities {
    grid-area: qualities;

    list-style: none;

    display: grid;

    grid-template-columns:
      repeat(
        3,
        minmax(0, 1fr)
      );

    gap: 0;

    margin: 0;
    padding: 0;
  }

  .about-qualities li {
    position: relative;

    display: flex;
    flex-direction: column;
    align-items: center;

    min-width: 0;

    padding-inline: 0.4rem;

    text-align: center;
  }

  .about-qualities
  li:not(:last-child)::after {
    content: "";

    position: absolute;

    top: 10%;
    right: 0;

    width: 1px;
    height: 80%;

    background:
      var(--color-border);
  }

  .quality-icon {
    width: 2.9rem;
    height: 2.9rem;

    display: grid;
    place-items: center;

    margin-bottom: 0.55rem;

    color:
      var(--color-secondary);

    background:
      linear-gradient(
        145deg,
        var(--color-surface-soft),
        #fff7f8
      );

    border:
      1px solid
      rgb(247 183 195 / 0.3);

    border-radius:
      var(--radius-pill);

    transition:
      transform
      var(--transition-fast),
      box-shadow
      var(--transition-fast);
  }

  .about-qualities h3 {
    max-width: 6.5rem;

    font-size: 0.73rem;
    line-height: 1.2;

    color:
      var(--color-secondary);
  }

  /* =========================================================
     FRASE
     ========================================================= */

  .about-quote {
    grid-area: quote;

    display: grid;

    grid-template-columns:
      auto
      minmax(0, 1fr)
      auto;

    align-items: center;

    gap: 0.6rem;

    width: 100%;
    max-width: 28rem;

    margin: 0 auto;

    padding:
      0.8rem
      1rem;

    background:
      rgb(253 236 239 / 0.52);

    border:
      1px dashed
      var(--color-accent);

    border-radius: 2rem;
  }

  .quote-mark {
    font-family:
      var(--font-family-heading);

    font-size: 2.2rem;
    line-height: 1;

    color:
      var(--color-primary);
  }

  .about-quote p {
    margin: 0;

    font-family:
      var(--font-family-heading);

    font-size: 0.84rem;
    line-height: 1.3;

    text-align: center;

    color:
      var(--color-secondary);
  }

  .quote-heart {
    font-size: 1.2rem;

    color:
      var(--color-primary);
  }

  /* =========================================================
     TABLET
     ========================================================= */

  @media (min-width: 700px) {
    .about {
      padding-block: 5rem;
    }

    .about-container {
      grid-template-columns:
        11rem
        minmax(0, 1fr);

      column-gap: 2.25rem;
      row-gap: 2.5rem;
    }

    .about-visual {
      width: 10rem;
    }

    .about-intro h2 {
      font-size: 2.7rem;
    }

    .about-description {
      max-width: 24rem;

      font-size: 1rem;
    }

    .quality-icon {
      width: 3.5rem;
      height: 3.5rem;
    }

    .quality-icon
    :global(svg) {
      width: 1.75rem;
      height: 1.75rem;
    }

    .about-qualities h3 {
      max-width: 8rem;

      font-size: 0.88rem;
    }

    .about-quote p {
      font-size: 0.95rem;
    }
  }

  /* =========================================================
     DESKTOP
     ========================================================= */

  @media (min-width: 900px) {
    .about {
      padding-block: 4.5rem;
    }

    .about-container {
      grid-template-columns:
        minmax(21rem, 0.95fr)
        minmax(0, 1.05fr);

      grid-template-areas:
        "visual intro"
        "visual qualities"
        "visual quote";

      align-items: center;

      column-gap: 3.25rem;
      row-gap: 1.1rem;
    }

    /* =========================
       Foto grande
       ========================= */

    .about-visual {
      width:
        min(
          100%,
          24rem
        );

      justify-self: start;
      align-self: center;
    }

    .about-photo {
      aspect-ratio: 4 / 4.35;

      border-radius:
        24% 30% 25% 20% /
        18% 22% 24% 20%;

      box-shadow:
        0 18px 42px
        rgb(39 48 90 / 0.08);
    }

    .about-photo-shape {
      inset:
        1rem
        -0.8rem
        -0.75rem
        1rem;

      border-radius:
        32% 40% 34% 28% /
        28% 30% 36% 30%;
    }

    .about-photo
    :global(.about-image) {
      transform:
        scale(1.015);
    }

    .photo-heart {
      top: -0.6rem;
      right: 0.5rem;

      width: 2.5rem;
      height: 2.5rem;

      font-size: 1rem;
    }

    .photo-paw {
      right: -0.65rem;
      bottom: 1.2rem;

      width: 3rem;
      height: 3rem;

      font-size: 1.05rem;

      border-width: 4px;
    }

    /* =========================
       Texto
       ========================= */

    .about-intro {
      align-self: end;
    }

    .about-intro h2 {
      max-width: none;

      font-size:
        clamp(
          2.5rem,
          3vw,
          3.1rem
        );
    }

    .about-intro h2 span {
      font-size: 0.95rem;
    }

    .about-description {
      max-width: 32rem;

      margin-top: 0.8rem;

      font-size: 1.05rem;
      line-height: 1.65;
    }

    /* =========================
       Cualidades
       ========================= */

    .about-qualities {
      max-width: 34rem;
    }

    .quality-icon {
      width: 3.75rem;
      height: 3.75rem;
    }

    .quality-icon
    :global(svg) {
      width: 1.85rem;
      height: 1.85rem;
    }

    .about-qualities h3 {
      max-width: 8.5rem;

      font-size: 0.9rem;
    }

    /* =========================
       Frase
       ========================= */

    .about-quote {
      width: 100%;
      max-width: 32rem;

      margin: 0;

      padding:
        0.85rem
        1.15rem;
    }

    .about-quote p {
      font-size: 0.95rem;
    }
  }

  /* =========================================================
     HOVER DESKTOP
     ========================================================= */

  @media (hover: hover) and (pointer: fine) {
    .about-photo:hover {
      transform:
        translateY(-0.25rem)
        rotate(-0.35deg);

      box-shadow:
        0 22px 46px
        rgb(39 48 90 / 0.12);
    }

    .about-qualities
    li:hover
    .quality-icon {
      transform:
        translateY(-0.2rem)
        scale(1.05);

      box-shadow:
        0 8px 20px
        rgb(244 143 163 / 0.14);
    }
  }
</style>