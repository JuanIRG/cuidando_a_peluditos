---
import {
  Heart,
  HeartHandshake,
  MapPin,
  MessageCircleHeart,
  PawPrint,
} from "@lucide/astro";

import {
  siInstagram,
  siWhatsapp,
} from "simple-icons";

const instagramUrl =
  "https://www.instagram.com/cuidando_a_peluditos/";

const whatsappUrl =
  "https://wa.me/56998817498";

const showWhatsApp = true;
---

<section
  class="contact"
  aria-labelledby="contact-title"
>
  <div class="container contact-container">

    <!-- =====================================================
         COLUMNA PRINCIPAL
         ===================================================== -->

    <div class="contact-main">

      <header
        id="contacto"
        class="contact-heading"
        data-reveal="left"
      >
        <div
          class="contact-heading-decoration"
          aria-hidden="true"
        >
          <Heart
            size={22}
            stroke-width={1.6}
          />
        </div>

        <h2 id="contact-title">
          Hablemos sobre tu peludito
        </h2>

        <p>
          Si quieres consultar disponibilidad,
          agendar o contarme sobre tu peludito,
          puedes escribirme directamente.
        </p>
      </header>

      <!-- ===================================================
           REDES SOCIALES
           =================================================== -->

      <div
        class="contact-actions"
        data-reveal="up"
        data-reveal-delay="120"
      >
        <!-- Instagram -->

        <a
          class="social-button social-instagram"
          href={instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Ir al Instagram de Cuidando a Peluditos"
        >
          <span class="social-icon">
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d={siInstagram.path}></path>
            </svg>
          </span>

          <span>
            Instagram
          </span>
        </a>

        <!-- WhatsApp -->

        {
          showWhatsApp && (
            <a
              class="social-button social-whatsapp"
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Contactar a Cuidando a Peluditos por WhatsApp"
            >
              <span class="social-icon">
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d={siWhatsapp.path}></path>
                </svg>
              </span>

              <span>
                WhatsApp
              </span>
            </a>
          )
        }
      </div>

      <!-- pequeña frase -->

      <div
        class="contact-small-note"
        data-reveal="up"
        data-reveal-delay="180"
      >
        <PawPrint
          size={16}
          stroke-width={1.8}
          aria-hidden="true"
        />

        <span>
          Cuéntame sobre su rutina y vemos
          qué servicio se adapta mejor.
        </span>
      </div>

    </div>

    <!-- =====================================================
         INFORMACIÓN
         ===================================================== -->

    <div class="contact-info">

      <!-- Cobertura -->

      <article
        class="contact-card"
        data-reveal="right"
      >
        <div
          class="contact-card-icon"
          aria-hidden="true"
        >
          <MapPin
            size={24}
            stroke-width={1.8}
          />
        </div>

        <div class="contact-card-content">
          <h3>
            Cobertura de servicios
          </h3>

          <p>
            Sector Oriente de Santiago.
          </p>
        </div>

        <Heart
          class="contact-card-decoration"
          size={20}
          stroke-width={1.5}
          aria-hidden="true"
        />
      </article>

      <!-- Contacto directo -->

      <article
        class="contact-card"
        data-reveal="right"
        data-reveal-delay="120"
      >
        <div
          class="contact-card-icon"
          aria-hidden="true"
        >
          <MessageCircleHeart
            size={24}
            stroke-width={1.8}
          />
        </div>

        <div class="contact-card-content">
          <h3>
            Contacto directo
          </h3>

          <p>
            Consulta disponibilidad y agenda
            directamente por redes.
          </p>
        </div>

        <Heart
          class="contact-card-decoration"
          size={20}
          stroke-width={1.5}
          aria-hidden="true"
        />
      </article>

      <!-- Atención personalizada -->

      <article
        class="contact-card"
        data-reveal="right"
        data-reveal-delay="240"
      >
        <div
          class="contact-card-icon"
          aria-hidden="true"
        >
          <HeartHandshake
            size={24}
            stroke-width={1.8}
          />
        </div>

        <div class="contact-card-content">
          <h3>
            Atención personalizada
          </h3>

          <p>
            Cada cuidado se conversa según
            la rutina y necesidades de tu peludito.
          </p>
        </div>

        <Heart
          class="contact-card-decoration"
          size={20}
          stroke-width={1.5}
          aria-hidden="true"
        />
      </article>

    </div>

  </div>

  <!-- =====================================================
       DECORACIONES DE FONDO
       ===================================================== -->

  <span
    class="contact-blob contact-blob-top"
    aria-hidden="true"
  ></span>

  <span
    class="contact-blob contact-blob-bottom"
    aria-hidden="true"
  ></span>

  <span
    class="contact-background-paw"
    aria-hidden="true"
  >
    <PawPrint
      size={34}
      stroke-width={1.3}
    />
  </span>

</section>

<style>
  /* =========================================================
     SECTION
     ========================================================= */

  .contact {
    position: relative;

    overflow: hidden;

    padding:
      4.5rem
      0
      5rem;

    background:
      linear-gradient(
        180deg,
        #fffdfb 0%,
        var(--color-background) 100%
      );
  }

  .contact-container {
    position: relative;

    z-index: 1;

    display: grid;

    grid-template-columns:
      minmax(0, 1fr);

    gap: 3rem;
  }

  /* =========================================================
     PRINCIPAL
     ========================================================= */

  .contact-main {
    display: flex;
    flex-direction: column;

    align-items: center;

    text-align: center;
  }

  /* =========================================================
     HEADING
     ========================================================= */

  .contact-heading {
    max-width: 34rem;

    scroll-margin-top: 5rem;
  }

  .contact-heading-decoration {
    width: 2.4rem;
    height: 2.4rem;

    display: grid;
    place-items: center;

    margin:
      0
      auto
      0.65rem;

    color:
      var(--color-primary);

    background:
      var(--color-surface-soft);

    border-radius:
      var(--radius-pill);
  }

  .contact-heading h2 {
    max-width: 18rem;

    margin-inline: auto;

    font-size:
      clamp(
        1.9rem,
        7.8vw,
        2.45rem
      );

    line-height: 1.05;

    letter-spacing:
      -0.025em;
  }

  .contact-heading p {
    max-width: 30rem;

    margin:
      0.85rem
      auto
      0;

    font-size: 0.93rem;
    line-height: 1.65;

    color:
      var(--color-text-muted);
  }

  /* =========================================================
     REDES
     ========================================================= */

  .contact-actions {
    width: 100%;

    display: flex;
    flex-wrap: wrap;
    justify-content: center;

    gap: 0.75rem;

    margin-top: 1.6rem;
  }

  /* =========================================================
     SOCIAL BUTTON
     ========================================================= */

  .social-button {
    min-width: 8.8rem;
    min-height: 3.15rem;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 0.7rem;

    padding:
      0.55rem
      1.15rem
      0.55rem
      0.6rem;

    font-size: 0.95rem;

    font-weight:
      var(--font-weight-bold);

    border-radius:
      var(--radius-pill);

    transition:
      transform
        var(--transition-fast),
      box-shadow
        var(--transition-fast),
      filter
        var(--transition-fast);
  }

  /* =========================================================
     ICONO RED SOCIAL
     ========================================================= */

  .social-icon {
    width: 2.15rem;
    height: 2.15rem;

    display: grid;
    place-items: center;

    flex-shrink: 0;

    background:
      rgb(255 255 255 / 0.18);

    border:
      1px solid
      rgb(255 255 255 / 0.22);

    border-radius:
      var(--radius-pill);
  }

  .social-icon svg {
    width: 1.15rem;
    height: 1.15rem;

    display: block;

    fill: currentColor;
  }

  /* =========================================================
     INSTAGRAM
     ========================================================= */

  .social-instagram {
    color: white;

    background:
      linear-gradient(
        135deg,
        var(--color-primary),
        var(--color-primary-dark)
      );

    box-shadow:
      0 9px 22px
      rgb(244 143 163 / 0.23);
  }

  /* =========================================================
     WHATSAPP
     ========================================================= */

  .social-whatsapp {
    color: white;

    background:
      linear-gradient(
        135deg,
        #78a96d,
        #668f5d
      );

    box-shadow:
      0 9px 22px
      rgb(102 143 93 / 0.18);
  }

  /* =========================================================
     NOTA BAJO BOTONES
     ========================================================= */

  .contact-small-note {
    display: inline-flex;
    align-items: center;

    gap: 0.45rem;

    max-width: 27rem;

    margin-top: 1.2rem;

    font-size: 0.8rem;
    line-height: 1.45;

    color:
      var(--color-text-muted);
  }

  .contact-small-note > svg {
    flex-shrink: 0;

    color:
      var(--color-primary);
  }

  /* =========================================================
     CARDS
     ========================================================= */

  .contact-info {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr);

    gap: 0.9rem;
  }

  .contact-card {
    position: relative;

    display: grid;

    grid-template-columns:
      auto
      minmax(0, 1fr);

    align-items: center;

    gap: 1rem;

    min-height: 6.4rem;

    padding:
      1rem
      3rem
      1rem
      1rem;

    overflow: hidden;

    background:
      rgb(255 255 255 / 0.8);

    border:
      1px solid
      rgb(247 183 195 / 0.48);

    border-radius:
      1.6rem;

    box-shadow:
      0 9px 25px
      rgb(39 48 90 / 0.055);

    transition:
      transform
        var(--transition-normal),
      box-shadow
        var(--transition-normal),
      border-color
        var(--transition-fast);
  }

  /* =========================================================
     CARD ICON
     ========================================================= */

  .contact-card-icon {
    width: 3rem;
    height: 3rem;

    display: grid;
    place-items: center;

    flex-shrink: 0;

    color:
      var(--color-secondary);

    background:
      rgb(39 48 90 / 0.065);

    border:
      1px solid
      rgb(39 48 90 / 0.055);

    border-radius:
      var(--radius-pill);
  }

  /* =========================================================
     CARD CONTENT
     ========================================================= */

  .contact-card-content {
    min-width: 0;
  }

  .contact-card-content h3 {
    margin: 0;

    font-size: 1rem;
    line-height: 1.25;

    letter-spacing:
      -0.01em;
  }

  .contact-card-content p {
    max-width: 25rem;

    margin-top: 0.2rem;

    font-size: 0.86rem;
    line-height: 1.5;

    color:
      var(--color-text-muted);
  }

  /* =========================================================
     CORAZÓN DECORATIVO CARD
     ========================================================= */

  .contact-card-decoration {
    position: absolute;

    right: 1rem;
    top: 50%;

    color:
      rgb(244 143 163 / 0.45);

    transform:
      translateY(-50%)
      rotate(8deg);

    pointer-events: none;
  }

  /* =========================================================
     FONDO
     ========================================================= */

  .contact-blob,
  .contact-background-paw {
    position: absolute;

    z-index: 0;

    pointer-events: none;
  }

  .contact-blob-top {
    width: 14rem;
    height: 8rem;

    top: -4rem;
    left: -5rem;

    background:
      rgb(247 183 195 / 0.15);

    border-radius:
      45% 55% 60% 40% /
      50% 45% 55% 50%;

    transform:
      rotate(-8deg);
  }

  .contact-blob-bottom {
    width: 16rem;
    height: 9rem;

    right: -6rem;
    bottom: -4rem;

    background:
      rgb(247 183 195 / 0.14);

    border-radius:
      55% 45% 42% 58% /
      44% 55% 45% 56%;

    transform:
      rotate(8deg);
  }

  .contact-background-paw {
    right: 1.25rem;
    bottom: 1.25rem;

    color:
      rgb(244 143 163 / 0.22);

    transform:
      rotate(12deg);
  }

  /* =========================================================
     TABLET
     ========================================================= */

  @media (min-width: 700px) {
    .contact {
      padding:
        5rem
        0
        5.5rem;
    }

    .contact-container {
      gap: 3.25rem;
    }

    .contact-heading h2 {
      max-width: none;

      font-size: 2.7rem;
    }

    .contact-heading p {
      font-size: 1rem;
    }

    .contact-actions {
      gap: 0.9rem;

      margin-top: 1.75rem;
    }

    .social-button {
      min-width: 10.5rem;

      min-height: 3.35rem;

      font-size: 1rem;
    }

    .contact-card {
      min-height: 6.75rem;

      padding:
        1.15rem
        3.5rem
        1.15rem
        1.15rem;
    }

    .contact-card-content h3 {
      font-size: 1.05rem;
    }

    .contact-card-content p {
      font-size: 0.92rem;
    }
  }

  /* =========================================================
     DESKTOP
     ========================================================= */

  @media (min-width: 1000px) {
    .contact-container {
      grid-template-columns:
        minmax(0, 0.9fr)
        minmax(31rem, 1.1fr);

      align-items: start;

      gap: 4.5rem;
    }

    .contact-main {
      align-items: flex-start;

      text-align: left;

      padding-top: 0.2rem;
    }

    /* =========================
       IZQUIERDA
       ========================= */

    .contact-heading {
      position: relative;

      max-width: 35rem;

      scroll-margin-top: 6rem;
    }

    .contact-heading-decoration {
      position: absolute;

      top: -2.8rem;
      left: 0;

      margin: 0;
    }

    .contact-heading h2 {
      max-width: 25rem;

      margin: 0;

      font-size: 2.5rem;

      line-height: 1.05;
    }

    .contact-heading p {
      max-width: 31rem;

      margin:
        0.85rem
        0
        0;

      font-size: 1rem;
      line-height: 1.65;
    }

    .contact-actions {
      width: auto;

      justify-content: flex-start;

      margin-top: 1.65rem;
    }

    .contact-small-note {
      margin-top: 1.15rem;
    }

    /* =========================
       DERECHA
       ========================= */

    .contact-info {
      gap: 1rem;
    }

    .contact-card {
      min-height: 7rem;

      padding:
        1.15rem
        3.5rem
        1.15rem
        1.15rem;

      border-radius:
        1.65rem;
    }

    .contact-card-icon {
      width: 3.1rem;
      height: 3.1rem;
    }

    .contact-card-content h3 {
      font-size: 1.05rem;
    }

    .contact-card-content p {
      font-size: 0.92rem;
    }

    .contact-card-decoration {
      right: 1.25rem;
    }
  }

  /* =========================================================
     HOVER
     ========================================================= */

  @media (hover: hover) and (pointer: fine) {
    .social-button:hover {
      transform:
        translateY(-2px);

      filter:
        brightness(1.035);
    }

    .social-instagram:hover {
      box-shadow:
        0 12px 27px
        rgb(244 143 163 / 0.3);
    }

    .social-whatsapp:hover {
      box-shadow:
        0 12px 27px
        rgb(102 143 93 / 0.25);
    }

    .contact-card:hover {
      transform:
        translateY(-0.2rem);

      border-color:
        rgb(244 143 163 / 0.68);

      box-shadow:
        0 13px 30px
        rgb(39 48 90 / 0.075);
    }
  }
</style>