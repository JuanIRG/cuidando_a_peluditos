---
import { Image } from "astro:assets";
import { Heart, PawPrint } from "@lucide/astro";

import paseoImg from "../../assets/images/paseo.png";
import cuidadoImg from "../../assets/images/cuidado.png";
import especialImg from "../../assets/images/especial.png";

const services = [
  {
    title: "Paseos",
    description:
      "Paseos con cariño, dedicación y entretención para que tu peludito disfrute, se active y libere energía.",
    image: paseoImg,
    alt: "Servicio de paseos para Mascotas",
  },
  {
    title: "Cuidados",
    description:
      "Acompañamiento y cuidado con compañía, atención y muchos mimos cuando no puedas estar a su lado.",
    image: cuidadoImg,
    alt: "Servicio de cuidados para Mascotas",
  },
  {
    title: "Especiales",
    description:
      "Eventos o Cuidados personalizados para cachorros, peluditos mayores o con necesidades y rutinas especiales.",
    image: especialImg,
    alt: "Servicio de cuidados especiales para Mascotas",
  },
];
---

<section
  class="services"
  aria-labelledby="services-title"
>
  <div class="container services-container">

    <!-- =====================================================
         ENCABEZADO
         ===================================================== -->

    <header
      id="servicios"
      class="services-heading"
      data-reveal="up"
    >
      <div
        class="services-icon"
        aria-hidden="true"
      >
        <PawPrint
          size={17}
          stroke-width={1.9}
        />
      </div>

      <h2 id="services-title">
        Servicios
      </h2>

      <p>
        Todo lo que tu peludito necesita
        para sentirse cuidado, feliz y acompañado.
      </p>
    </header>

    <!-- =====================================================
         CARDS
         ===================================================== -->

    <div class="services-grid">
      {
        services.map((service, index) => (
          <article
            class="service-card"
            data-reveal="up"
            data-reveal-delay={`${index * 120}`}
          >
            <div class="service-image">
              <Image
                src={service.image}
                alt={service.alt}
                class="service-image-file"
                loading="lazy"
                decoding="async"
                quality={70}
                widths={[320, 480, 640]}
                sizes="(max-width: 699px) calc(100vw - 2.5rem), (max-width: 999px) 45vw, 22rem"
              />
            </div>

            <div class="service-content">
              <h3>
                {service.title}
              </h3>

              <p>
                {service.description}
              </p>
            </div>
          </article>
        ))
      }
    </div>

  </div>

  <!-- =====================================================
       DECORACIONES
       ===================================================== -->

  <span
    class="services-decoration services-heart"
    aria-hidden="true"
  >
    <Heart
      size={26}
      stroke-width={1.5}
    />
  </span>

  <span
    class="services-decoration services-paw"
    aria-hidden="true"
  >
    <PawPrint
      size={23}
      stroke-width={1.5}
    />
  </span>

  <span
    class="services-blob services-blob-top"
    aria-hidden="true"
  ></span>

  <span
    class="services-blob services-blob-bottom"
    aria-hidden="true"
  ></span>
</section>

<style>
  /* =========================================================
     SECTION
     ========================================================= */

  .services {
    position: relative;

    overflow: hidden;

    padding:
      4rem
      0
      4.5rem;

    background:
      linear-gradient(
        180deg,
        #fffdfb 0%,
        var(--color-background) 100%
      );
  }

  .services-container {
    position: relative;
    z-index: 1;
  }

  /* =========================================================
     ENCABEZADO
     ========================================================= */

  .services-heading {
    max-width: 34rem;

    margin:
      0
      auto
      2.25rem;

    text-align: center;

    scroll-margin-top: 4.5rem;
  }

  .services-icon {
    width: 2.25rem;
    height: 2.25rem;

    display: grid;
    place-items: center;

    margin:
      0
      auto
      0.5rem;

    color:
      var(--color-primary);

    background:
      var(--color-surface-soft);

    border-radius:
      var(--radius-pill);
  }

  .services-heading h2 {
    font-size:
      clamp(
        1.9rem,
        7.8vw,
        2.45rem
      );

    line-height: 1.05;

    letter-spacing:
      -0.025em;
  }

  .services-heading p {
    max-width: 31rem;

    margin:
      0.75rem
      auto
      0;

    font-size: 0.92rem;
    line-height: 1.6;

    color:
      var(--color-text-muted);
  }

  /* =========================================================
     GRID
     ========================================================= */

  .services-grid {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr);

    gap: 1.25rem;
  }

  /* =========================================================
     CARD
     ========================================================= */

  .service-card {
    position: relative;

    display: grid;

    grid-template-columns:
      minmax(0, 1fr);

    gap: 1rem;

    padding: 1rem;

    background:
      rgb(255 255 255 / 0.82);

    border:
      1px solid
      rgb(242 223 227 / 0.65);

    border-radius:
      1.7rem;

    box-shadow:
      0 10px 28px
      rgb(39 48 90 / 0.065);

    transition:
      transform
      var(--transition-normal),
      box-shadow
      var(--transition-normal),
      border-color
      var(--transition-fast);
  }

  /* =========================================================
     IMAGEN
     ========================================================= */

  .service-image {
    width: 100%;

    overflow: hidden;

    border-radius:
      1.35rem;

    background:
      var(--color-surface-soft);
  }

  .service-image
  :global(.service-image-file) {
    width: 100%;
    height: auto;

    display: block;
  }

  /* =========================================================
     CONTENIDO
     ========================================================= */

  .service-content {
    padding:
      0.15rem
      0.35rem
      0.4rem;

    text-align: center;
  }

  .service-content h3 {
    margin-bottom: 0.6rem;

    font-size:
      clamp(
        1.5rem,
        5.5vw,
        1.8rem
      );

    line-height: 1.05;

    letter-spacing:
      -0.015em;
  }

  .service-content p {
    max-width: 19rem;

    margin-inline: auto;

    font-size: 0.9rem;
    line-height: 1.6;

    color:
      var(--color-text-muted);
  }

  /* =========================================================
     DECORACIONES
     ========================================================= */

  .services-decoration {
    position: absolute;

    z-index: 0;

    color:
      rgb(244 143 163 / 0.42);

    pointer-events: none;
  }

  .services-heart {
    right: 1.5rem;
    top: 7rem;

    transform:
      rotate(12deg);
  }

  .services-paw {
    left: 1.25rem;
    bottom: 3rem;

    transform:
      rotate(-10deg);
  }

  .services-blob {
    position: absolute;

    z-index: 0;

    pointer-events: none;
  }

  .services-blob-top {
    width: 11rem;
    height: 6rem;

    top: -3rem;
    left: -4rem;

    background:
      rgb(247 183 195 / 0.14);

    border-radius:
      45% 55% 60% 40% /
      50% 45% 55% 50%;

    transform:
      rotate(-7deg);
  }

  .services-blob-bottom {
    width: 13rem;
    height: 7rem;

    right: -5rem;
    bottom: -3rem;

    background:
      rgb(247 183 195 / 0.16);

    border-radius:
      55% 45% 42% 58% /
      44% 55% 45% 56%;

    transform:
      rotate(8deg);
  }

  /* =========================================================
     TABLET
     ========================================================= */

  @media (min-width: 700px) {
    .services {
      padding:
        4.5rem
        0
        5rem;
    }

    .services-heading {
      margin-bottom: 2.5rem;

      scroll-margin-top: 5rem;
    }

    .services-heading h2 {
      font-size: 2.7rem;
    }

    .services-heading p {
      font-size: 1rem;
    }

    .service-card {
      grid-template-columns:
        minmax(15rem, 1.05fr)
        minmax(0, 0.95fr);

      align-items: center;

      gap: 1.4rem;

      padding: 1.1rem;
    }

    .service-content {
      padding:
        0
        1rem
        0
        0;

      text-align: left;
    }

    .service-content h3 {
      font-size: 1.85rem;
    }

    .service-content p {
      max-width: 22rem;

      margin: 0;

      font-size: 0.95rem;
    }
  }

  /* =========================================================
     DESKTOP
     ========================================================= */

  @media (min-width: 1000px) {
    .services {
      padding:
        5rem
        0
        5.25rem;
    }

    .services-heading {
      margin-bottom: 2.75rem;

      scroll-margin-top: 6rem;
    }

    .services-heading h2 {
      font-size: 2.5rem;
    }

    .services-heading p {
      font-size: 1rem;
    }

    .services-grid {
      grid-template-columns:
        repeat(
          3,
          minmax(0, 1fr)
        );

      gap: 1.5rem;
    }

    .service-card {
      grid-template-columns:
        minmax(0, 1fr);

      grid-template-rows:
        auto
        1fr;

      align-items: start;

      gap: 1rem;

      padding:
        1rem
        1rem
        1.4rem;

      border-radius:
        1.8rem;
    }

    .service-content {
      padding:
        0.15rem
        0.6rem
        0;

      text-align: center;
    }

    .service-content h3 {
      font-size: 1.8rem;
    }

    .service-content p {
      max-width: 18rem;

      margin-inline: auto;

      font-size: 0.93rem;
      line-height: 1.6;
    }

    .services-heart {
      right: 3rem;
      top: 7rem;
    }

    .services-paw {
      left: 2.5rem;
      bottom: 3.5rem;
    }
  }

  /* =========================================================
     HOVER
     ========================================================= */

  @media (hover: hover) and (pointer: fine) {
    .service-card:hover {
      transform:
        translateY(-0.25rem);

      border-color:
        rgb(244 143 163 / 0.22);

      box-shadow:
        0 16px 34px
        rgb(39 48 90 / 0.1);
    }
  }
</style>